{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parlay Locks candidates v1 — data/candidates/YYYY-MM-DD-{morning|pregame}.json",
  "type": "object",
  "required": ["schema", "run", "date", "snapshot", "created_at", "author", "legs"],
  "properties": {
    "schema": { "const": "candidates/v1" },
    "run": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}-(morning|pregame)$" },
    "date": { "type": "string", "format": "date" },
    "snapshot": { "enum": ["morning", "pregame"] },
    "created_at": { "type": "string", "description": "ISO 8601 with ET offset, e.g. 2026-11-12T10:12:00-05:00" },
    "author": { "type": "string", "default": "parlay-locks" },
    "slate_notes": { "type": "string", "description": "Short overview of the day's slate / why these spots" },
    "legs": {
      "type": "array", "minItems": 1, "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "sport", "event", "player", "market", "line", "pick", "reasoning"],
        "properties": {
          "id": { "type": "string", "pattern": "^L\\d+$" },
          "sport": { "type": "string", "examples": ["NBA", "NFL", "NHL", "CBB", "CFB", "Soccer"] },
          "event": { "type": "string", "examples": ["BOS @ NYK"] },
          "start_time": { "type": "string", "description": "ISO 8601 ET" },
          "player": { "type": "string" },
          "team": { "type": "string" },
          "market": { "type": "string", "examples": ["Points", "Rebounds", "Pass Yards", "Shots on Goal"] },
          "line": { "type": "number" },
          "pick": { "enum": ["over", "under", "more", "less"] },
          "platforms": { "type": "array", "items": { "enum": ["prizepicks", "underdog", "other"] } },
          "est_prob": { "type": "number", "minimum": 0, "maximum": 1, "description": "Drafter's estimated hit probability" },
          "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
          "reasoning": { "type": "string", "description": "Drafter's reasoning paragraph" },
          "key_stats": { "type": "array", "items": { "type": "string" } },
          "injury_notes": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "object", "required": ["url"], "properties": { "title": { "type": "string" }, "url": { "type": "string" } } } }
        }
      }
    }
  }
}
